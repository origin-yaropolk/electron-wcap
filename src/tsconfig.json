{
	"extends": [
		"@tsconfig/node22/tsconfig.json",
	],
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"composite": false,
		"noUncheckedIndexedAccess": false,
		"noUnusedLocals": false,
		"sourceMap": true,
		"outDir": "../dist",
		"isolatedModules": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": [
			"node",
			"jest",
		],
		"lib": [
			"dom",
			"es2022",
		],
	},

	"include": ["**/*.ts", "../test/**/*.ts"],
	"exclude": [
		"node_modules/**",
	]
}

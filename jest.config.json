{
	"preset": "ts-jest",
	"testEnvironment": "node",
	"roots": ["<rootDir>"],
	"testMatch": ["**/*.test.ts"],
	"modulePathIgnorePatterns": ["<rootDir>/dist"],
	"testPathIgnorePatterns": ["node_modules", "dist", "test/integration"],
	"transform": {
		"^.+\\.ts$": [
			"ts-jest", {
				"tsconfig": "./src/tsconfig.json"
			}
		]
	}
}
